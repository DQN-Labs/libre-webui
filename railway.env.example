# Railway Environment Variables
# Copy these to your Railway project settings

PORT=3001
NODE_ENV=production
OLLAMA_BASE_URL=
CORS_ORIGIN=https://dqnlabsai.web.app
DATA_DIR=./data
OLLAMA_TIMEOUT=300000
OLLAMA_LONG_OPERATION_TIMEOUT=900000
SINGLE_USER_MODE=false
JWT_SECRET=generate-a-random-32-char-string
JWT_EXPIRES_IN=7d
ENABLE_SIGNUP=true

# Add your API keys (set in Railway dashboard, not here)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
